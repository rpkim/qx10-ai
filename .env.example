# ── OpenAI (optional if you only use Gemini) ─────────────────────────────
OPENAI_API_KEY=sk-...

# Comma-separated models shown in the Query node (default: OPENAI_MODEL or gpt-4o-mini)
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Legacy single-model fallback when OPENAI_MODELS is unset
# OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (optional if you only use OpenAI) ─────────────────────
# Or use GOOGLE_GENERATIVE_AI_API_KEY (same value)
GEMINI_API_KEY=

# Comma-separated Gemini model ids (default: gemini-2.0-flash)
# GEMINI_MODELS=gemini-2.0-flash,gemini-2.5-flash-preview-05-20

# ── Defaults & catalog ─────────────────────────────────────────────────
# Default selection when a query does not pick a model. Must match a catalog id: `provider:model`
# AI_DEFAULT=openai:gpt-4o-mini

# Optional: full JSON list (overrides OPENAI_MODELS / GEMINI_MODELS lists). Only entries for
# providers with keys are kept.
# AI_MODEL_OPTIONS=[{"id":"openai:gpt-4o-mini","provider":"openai","model":"gpt-4o-mini","label":"GPT-4o mini"},{"id":"gemini:gemini-2.0-flash","provider":"gemini","model":"gemini-2.0-flash","label":"Gemini 2.0 Flash"}]

# ── Direct market API (optional, for live quote data node) ─────────────────
# The quote URL template. Use {symbol} placeholder.
# Example: MARKET_API_URL_TEMPLATE=https://api.example.com/quote?symbol={symbol}
# MARKET_API_URL_TEMPLATE=
#
# Optional API key support:
# - Query param mode (e.g. apikey=...):
# MARKET_API_KEY=
# MARKET_API_KEY_QUERY_PARAM=apikey
#
# - Header mode (e.g. X-API-Key: ...):
# MARKET_API_KEY=
# MARKET_API_KEY_HEADER=X-API-Key
#
# If key is set and neither QUERY_PARAM nor HEADER is set, uses Authorization: Bearer <key>.

# ── Tavily (optional, Web Search tool) ─────────────────────────────────────
# When set, query nodes with "Web Search" use Tavily instead of DuckDuckGo for the data panel.
# Get a key at https://tavily.com — use the secret as Bearer (keys often look like tvly-...).
# TAVILY_API_KEY=
