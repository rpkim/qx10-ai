# ── OpenAI (optional if you only use Gemini) ─────────────────────────────
OPENAI_API_KEY=sk-...

# Comma-separated models shown in the Query node (default: OPENAI_MODEL or gpt-4o-mini)
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Legacy single-model fallback when OPENAI_MODELS is unset
# OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (optional if you only use OpenAI) ─────────────────────
# Or use GOOGLE_GENERATIVE_AI_API_KEY (same value)
GEMINI_API_KEY=

# Comma-separated Gemini model ids (default: gemini-3.5-flash)
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.0-flash

# ── Defaults & catalog ─────────────────────────────────────────────────
# Default selection when a query does not pick a model. Must match a catalog id: `provider:model`
# AI_DEFAULT=openai:gpt-4o-mini

# Optional: full JSON list (overrides OPENAI_MODELS / GEMINI_MODELS lists). Only entries for
# providers with keys are kept.
# AI_MODEL_OPTIONS=[{"id":"openai:gpt-4o-mini","provider":"openai","model":"gpt-4o-mini","label":"GPT-4o mini"},{"id":"gemini:gemini-2.0-flash","provider":"gemini","model":"gemini-2.0-flash","label":"Gemini 2.0 Flash"}]

# ── Direct market API (optional, for live quote data node) ─────────────────
# The quote URL template. Use {symbol} placeholder.
# Example: MARKET_API_URL_TEMPLATE=https://api.example.com/quote?symbol={symbol}
# MARKET_API_URL_TEMPLATE=
#
# Optional API key support:
# - Query param mode (e.g. apikey=...):
# MARKET_API_KEY=
# MARKET_API_KEY_QUERY_PARAM=apikey
#
# - Header mode (e.g. X-API-Key: ...):
# MARKET_API_KEY=
# MARKET_API_KEY_HEADER=X-API-Key
#
# If key is set and neither QUERY_PARAM nor HEADER is set, uses Authorization: Bearer <key>.

# ── Tavily (optional, Web Search tool) ─────────────────────────────────────
# When set, query nodes with "Web Search" use Tavily instead of DuckDuckGo for the data panel.
# Get a key at https://tavily.com — use the secret as Bearer (keys often look like tvly-...).
# TAVILY_API_KEY=

# ── Google Sign-In (REQUIRED for login) ───────────────────────────────────
# The whole app is gated behind Google sign-in. To run locally without auth,
# set AUTH_DISABLED=true (development only — never in production).
# Authorized redirect URI in your Google Cloud OAuth client:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AES-GCM secret used to seal sign-in session cookies (min 32 chars recommended).
# If unset, falls back to AUTH_SECRET. Rotating this value invalidates all sessions.
# QX10_AUTH_SECRET=
# AES-GCM secret for application-layer PII field encryption (email, name, picture,
# keywords stored in analytics DB). Recommended: 32+ random chars. Falls back to
# QX10_AUTH_SECRET / AUTH_SECRET if unset. Rotating this key requires re-encrypting
# existing rows — plan a migration before rotating in production.
# QX10_PII_SECRET=
# Local development escape hatch — bypass the login wall entirely. NEVER use
# in production.
# AUTH_DISABLED=false

# ── Admin allowlist (REQUIRED for /admin) ────────────────────────────────
# Comma-separated emails. The project owner (rpkim.jay@gmail.com) is always
# included as a built-in default so admin is bootstrappable on first deploy.
# ADMIN_EMAILS=rpkim.jay@gmail.com,teammate@example.com

# ── Analytics / admin store ───────────────────────────────────────────────
# Default: writes to a JSON file under .qx10-data/analytics.json. Works for
# local dev and long-running servers, but NOT on serverless platforms with
# read-only filesystems (Vercel etc.).
#
# Production: use Supabase (Postgres). Steps:
#   1. Create a project at https://supabase.com.
#   2. Open the SQL editor and run db/schema.sql once.
#   3. From "Project Settings → API" copy:
#      - Project URL → NEXT_PUBLIC_SUPABASE_URL (and SUPABASE_URL for server)
#      - publishable key → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (browser, optional)
#      - service_role key → SUPABASE_SERVICE_ROLE_KEY (server-only)
# The service role key has full DB access — keep it server-only and NEVER
# expose it to the browser.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Optional: direct Postgres URI to run `pnpm db:apply-workspaces` locally.
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# Override the default local file location (file backend only).
# QX10_DATA_DIR=.qx10-data


# ── TTS provider (optional) ────────────────────────────────────────────────
# default: browser
# NEXT_PUBLIC_TTS_PROVIDER=browser
# Server-side override (optional): browser | elevenlabs
# TTS_PROVIDER=browser
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
